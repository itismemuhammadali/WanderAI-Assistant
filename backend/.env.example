# ====================================================================
# TRAVEL ASSISTANT BACKEND CONFIGURATION
# Paste your Supabase & OpenRouteService keys here
# ====================================================================

# Supabase Cloud Database Configuration
# Get these from your Supabase Project Settings -> API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your-anon-or-service-role-key-here

# OpenRouteService API Key (Optional - Fallback polylines are pre-loaded)
OPENROUTESERVICE_KEY=5b3ce3597851110001cf6248...

# Server Host & Port
HOST=0.0.0.0
PORT=8000
